[gd_scene load_steps=4 format=3]

[ext_resource type="Script" uid="uid://ho2k6vwibax8" path="res://coin.gd" id="1_coin_script"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_coin"]
size = Vector2(1, 3)

[sub_resource type="CircleShape2D" id="CircleShape2D_pickup"]
; How close the player has to stand to pick this coin up. Bigger than the
; coin's own 1x3 px body on purpose -- the coin is too small to walk onto
; pixel-perfectly, so this is a generous catch radius around it instead.
; Started as an untested 16 px guess; Elliott playtested and widened it to
; 32 px.
radius = 32.0

[node name="Coin" type="RigidBody2D" groups=["metal"]]
mass = 0.004
freeze = true
script = ExtResource("1_coin_script")

[node name="Polygon2D" type="Polygon2D" parent="."]
position = Vector2(0, -1)
scale = Vector2(1, 1.5)
color = Color(0.91197884, 0.0025784366, 0.0014126375, 1)
polygon = PackedVector2Array(0, 0, 1, 0, 1, 2, 0, 2)

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0.5, 0.5)
shape = SubResource("RectangleShape2D_coin")

[node name="PickupArea" type="Area2D" parent="."]
; Off while the coin is in hand -- see coin.gd's release(), which is the only
; place this turns on. Left on, a held coin would immediately detect the
; player's own body standing right on top of it and could re-trigger its own
; pickup logic before it ever left the hand.
monitoring = false

[node name="CollisionShape2D" type="CollisionShape2D" parent="PickupArea"]
shape = SubResource("CircleShape2D_pickup")

[node name="TrajectoryTrace" type="Line2D" parent="."]
; top_level = true means this node ignores the Coin's own transform and
; draws using the same global coordinates coin.gd already appends to
; points with. Without it, a Line2D parented under a moving RigidBody2D would
; have its points re-interpreted in the coin's own local space every tick,
; warping the trail into following the coin instead of tracing where it flew.
top_level = true
width = 1.0
default_color = Color(1, 1, 0, 1)
